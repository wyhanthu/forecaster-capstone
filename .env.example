# Copy this file to .env and fill in your key. .env is in .gitignore; never commit it.
OPENAI_API_KEY=your-api-key-here
# Optional: any OpenAI-compatible endpoint and model
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4.1-mini
# OpenRouter instead of OpenAI: set these three (model names look like provider/model, see openrouter.ai/models; the model must
# support tool calling and JSON mode). With only OPENROUTER_API_KEY set, OpenRouter is chosen automatically.
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_MODEL=openai/gpt-4.1-mini
# Optional: pin the upstream provider (comma list). Fallbacks are then OFF, which keeps the prompt-cache hit rate high.
# OPENROUTER_PROVIDER=alibaba
# Optional: only set this if your model accepts a temperature (some models reject it)
# OPENAI_TEMPERATURE=0

# Required for --source edgar: SEC asks every client to identify itself (your name and e-mail).
SEC_USER_AGENT=Your Name your.email@example.com
